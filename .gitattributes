# Set default behavior to automatically normalize line endings
* text=auto

# Force bash scripts to use LF line endings (Unix-style)
*.sh text eol=lf

# Ensure Windows batch files use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Python files should use LF
*.py text eol=lf

# YAML files
*.yaml text eol=lf
*.yml text eol=lf

# Markdown files
*.md text eol=lf
